{
  "name": "hanengine-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + React desktop workspace for HanEngine",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "test:electron": "node --test electron/*.test.cjs",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.hanengine.desktop",
    "productName": "HanEngine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "hanengine-backend",
        "filter": [
          "cli.py",
          "translator.py",
          "game_localizer/**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
